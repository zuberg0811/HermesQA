# Nạp bằng: node --env-file=.env server.js  (hoặc đặt biến môi trường trước khi npm start)
OPENAI_PORT=3100
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# preset = system prompt Claude Code + SKILL.md của hermesQA; custom = chỉ SKILL.md
SYSTEM_MODE=preset
# số request Claude chạy song song
CONCURRENCY=2
# Để trống = thuần LLM. Ví dụ: WebFetch
CLAUDE_TOOLS=
# auto = trích JSON object khi prompt yêu cầu JSON; true/false ép
JSON_ONLY=auto
# Chỉ cần khi KHÔNG dùng tài khoản đã `claude login`
# ANTHROPIC_API_KEY=sk-ant-...
# huỷ 1 request Claude nếu quá lâu (ms); client OpenAI sẽ retry
REQUEST_TIMEOUT_MS=300000
