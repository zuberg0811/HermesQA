# ---- GitHub App ----
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-app.pem

# ---- Agent backend: "openai_compat" (OpenRouter/OpenAI/vLLM local) hoặc "hermes_cli"
AGENT_BACKEND=openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=anthropic/claude-sonnet-4
# Backend "anthropic" (SDK chính thức): AGENT_BACKEND=anthropic + key dưới đây
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Hermes Agent: lệnh CLI nhận prompt từ stdin và in JSON ra stdout (chỉnh theo bản Hermes bạn cài)
HERMES_CMD=hermes run --skill {skill_dir} --json

# ---- Infra ----
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://hermesqa:hermesqa@postgres:5432/hermesqa
RUNNER_IMAGE=hermesqa-runner:latest
WORKDIR=/data/work
REPORT_DIR=/data/reports

# ---- Review policy (mặc định; .hermesqa.yml trong repo có thể override) ----
MAX_COMMENTS_PER_PR=15
MIN_CONFIDENCE=0.6
MIN_SEVERITY_TO_COMMENT=medium
BLOCK_ON_CRITICAL=false

# ---- Website demo trên Firebase (docs/FIREBASE_DEMO.md) ----
# File service-account JSON; để trống -> run log và job demo ghi file JSON cục bộ trong data/
FIREBASE_CREDENTIALS=
# Nút "Review thử": chỉ repo mẫu, giới hạn tần suất, một lúc một review
DEMO_REPOS=dataset=eval/dataset-repo,dataset-multi=eval/dataset-repo-multi
DEMO_MAX_PER_HOUR=3
DEMO_REQUIRE_AUTH=true
DEMO_SKIP_STATIC=true
DEMO_TIMEOUT=900
DEMO_CORS_ORIGINS=https://hermesqa-demo.web.app,https://hermesqa-demo.firebaseapp.com
